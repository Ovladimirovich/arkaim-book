# Hermes Runtime — Environment Configuration
# Copy to .env and fill in your values.

# ── Auth ────────────────────────────────────────────────
HERMES_API_KEY=your-api-key-here

# ── Core runtime ──────────────────────────────────────
HERMES_SKILLS_PATH=
PROVIDER_CHAIN=gigachat,openrouter
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_COOLDOWN_SECONDS=60

# ── GigaChat ──────────────────────────────────────────
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL=true
GIGACHAT_TOKEN=

# ── OpenRouter ────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct

# ── Gateway ────────────────────────────────────────────
GATEWAY_URL=http://127.0.0.1:8000

# ── Telegram integration ───────────────────────────────
# Используется TELEGRAM_BOT_TOKEN в core/config.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_ADMIN_CHAT_ID=
TELEGRAM_POLL_INTERVAL=1
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_BASE_DELAY=2.0
TELEGRAM_RETRY_MAX_DELAY=30.0

# ── VK integration ────────────────────────────────────
VK_GROUP_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199

# ── X-RAY Observability ────────────────────────────
XRAY_TRACE_STORE_PATH=

# ── Deprecated (use HERMES_SKILLS_PATH instead) ────────
BUSINESS_PACK=

# ComfyUI (Cloudflare Tunnel from Colab)
# Run notebooks/comfyui_colab.ipynb, then paste the URL here
COMFYUI_URL=http://127.0.0.1:8188
