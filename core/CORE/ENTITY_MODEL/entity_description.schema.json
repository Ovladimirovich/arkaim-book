{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arkaim/ENTITY_DESCRIPTION_MODEL/v0.2",
  "title": "ARKAIM Entity Description Model (EDM) v0.2 (knowledge contract + description resolution, EDM-RES)",
  "description": "Единая структурная модель описательного знания о сущности мира. Знание, а не промпт: модели не хранят готовые описания для потребителей, потребители (dialogue/explorer/reconstruction/mediaplan/image/video) проецируются из ledger. Каждый атомарный факт — claim со статусом, классом provenance и confidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "identity", "claims"],
  "properties": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_version"],
      "properties": {
        "model_id": {"const": "arkaim-entity-description"},
        "model_version": {"type": "string"},
        "created_at": {"type": ["string", "null"]},
        "schema_version": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_id", "type"],
      "properties": {
        "canonical_id": {"type": "string", "minLength": 1},
        "type": {"$ref": "#/$defs/EntityType"},
        "names": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "aliases": {"type": "array", "items": {"type": "string"}, "default": []},
        "one_line": {"type": "string"},
        "is_reconstruction": {"type": "boolean", "default": false}
      }
    },
    "time": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "epoch_ref": {"type": "array", "items": {"type": "string"}},
        "start": {"type": ["string", "null"]},
        "end": {"type": ["string", "null"]},
        "temporal_links": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string"}
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/Claim"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/Relation"},
      "default": []
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "description": "Границы знания сущности. required_unknown — пути, которые ОБЯЗАНЫ присутствовать со статусом unknown (явная граница, а не молчаливая absence).",
      "properties": {
        "required_unknown": {"type": "array", "items": {"type": "string"}},
        "forbid_medium": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string"}
      },
      "default": {}
    },
    "pilot": {
      "type": "object",
      "additionalProperties": false,
      "description": "Метаданные пилотной миграции (extended_world -> EDM). Хранит исходную карточку, её provenance-категорию и полный round-trip-маппинг полей для контроля «ничего не потеряно».",
      "required": ["source_card_file"],
      "properties": {
        "source_card_file": {"type": "string", "description": "Исходный файл: категории extended_world (WORLD_MODEL/<CATEGORY>.json)"},
        "card_id": {"type": "string"},
        "provenance_category": {"type": "string"},
        "source_level": {"type": "string"},
        "roundtrip_map": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "properties": {"type": "object", "additionalProperties": {"type": "string"}, "description": "имя свойства карточки -> куда попало в EDM (например 'ext_model.<prop>' или time-block)"},
            "relationships": {"type": "string"},
            "provenance": {"type": "string"},
            "source": {"type": "string"},
            "confidence": {"type": "string"}
          }
        },
        "note": {"type": "string"}
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": true,
      "description": "Опциональный self-test блок: ожидаемые проекции (dialogue/mediaplan/explorer) для контроля, что единая модель даёт все 6 представлений."
    }
  },
  "$defs": {
    "EntityType": {
      "type": "string",
      "enum": ["location", "character", "building", "clothing", "object", "culture", "climate", "animal", "plant", "technology", "weather", "landscape"],
      "description": "Сущности мира (EDM-RES): animal/plant/technology/weather/landscape добавлены — факт/описание одинаково работает для всех типов; weather использует climate.*-пути, landscape — place.landscape"
    },
    "Status": {
      "type": "string",
      "enum": ["known", "unknown", "not_applicable", "inferred", "reconstructed", "hypothesis", "artistic_model", "fiction"],
      "description": "Semantics: unknown — осознанная граница знания (НЕ отсутствие поля); reconstructed/hypothesis — реконструкция/гипотеза; artistic_model/fiction — художественное заполнение/фикшн (EDM-RES), валидны только в пределах applies_to и никогда не повышают статус до known. medium=true обязателен для reconstructed/hypothesis/artistic_model/fiction."
    },
    "ProvenanceClass": {
      "type": "string",
      "enum": ["author_canon", "external_source", "derived", "ai_model", "ai_model_artistic", "reconstruction", "artistic_model", "fiction", "none"],
      "description": "AI-классы (ai_model*/artistic_model/fiction) ИСЧИСЛЯЮТСЯ ИЗ ARTISTIC_MODEL (G10): они не знание, а художественное допущение; medium-режим обязателен. artistic_model/fiction — явные owner-статусы художественного заполнения и фикшна (EDM-RES), всегда со scope."
    },
    "ClaimPath": {
      "type": "string",
      "enum": [
        "identity.one_line", "identity.is_reconstruction",
        "place.region", "place.coordinates", "place.landscape", "place.elevation", "place.water",
        "place.flora", "place.fauna", "place.landmark", "place.objects",
        "architecture.form", "architecture.style", "architecture.walls", "architecture.features", "architecture.materials",
        "environment.climate", "environment.weather", "environment.season",
        "environment.vegetation", "environment.water_features", "environment.time_of_day",
        "people.inhabitants", "people.associated_characters", "people.governor",
        "character.role", "character.existence",
        "character.age_range", "character.face", "character.hair", "character.eyes",
        "character.build", "character.clothing_daily", "character.clothing_ceremonial",
        "character.colors", "character.accessories", "character.mannerisms",
        "character.movement", "character.emotional_range", "character.objects",
        "clothing.items", "clothing.materials", "clothing.colors", "clothing.wearer",
        "object.items", "object.materials", "object.usage",
        "culture.practices", "culture.values", "culture.tech",
        "climate.type", "climate.temperature_range", "climate.precipitation", "climate.seasons",
        "animal.appearance", "plant.appearance", "plant.habitat",
        "technology.name", "technology.materials", "technology.usage", "technology.era"
      ]
    },
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "description": "Откуда факт: слой + идентификатор + путь внутри него. Позволяет восстановить цепочку до 6 исходных слоёв без изменения их форматов.",
      "properties": {
        "layer": {"type": "string", "enum": ["canonical_world", "extended_world", "form", "visual_knowledge", "genome", "knowledge_core", "external", "reconstruction", "pulse", "none"]},
        "ref": {"type": "string"},
        "path": {"type": "string"}
      }
    },
    "AppliesTo": {
      "type": "object",
      "additionalProperties": false,
      "description": "Scope применения claim'а (EDM-RES): художественное/фикшн-заполнение валидно только в пределах своего scope и не загрязняет World Model. level=world (или отсутствие applies_to) = глобально.",
      "required": ["level"],
      "properties": {
        "level": {"type": "string", "enum": ["world", "era", "place", "scene", "media_plan", "frame"]},
        "id": {"type": ["string", "null"]},
        "temporal_ref": {"type": ["string", "null"], "description": "Темпоральная применимость: epoch_ref / время сцены (свободный реф, точное совпадение)"},
        "note": {"type": "string"}
      }
    },
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "description": "Атомарный факт сущности. status=unknown — осознанная граница знания (обязательный claim, не отсутствие). status=reconstructed/hypothesis — может рендериться только при medium=true и всегда с явной меткой. status=artistic_model/fiction (EDM-RES) — художественное заполнение/фикшн: medium=true и applies_to обязательны, значение действует только в пределах scope и никогда не поднимает статус до known. Одно свойство (path) может нести несколько claim разных статусов/scope — это ledger, а не перезапись.",
      "required": ["path", "status", "provenance_class"],
      "properties": {
        "path": {"$ref": "#/$defs/ClaimPath"},
        "value": {"type": ["string", "number", "boolean", "array", "object", "null"]},
        "status": {"$ref": "#/$defs/Status"},
        "provenance_class": {"$ref": "#/$defs/ProvenanceClass"},
        "source_ref": {"$ref": "#/$defs/SourceRef"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "per-fact, а не одна цифра на объект"},
        "medium": {"type": "boolean", "default": false, "description": "true = художественное допущение, может участвовать в visual-рендере только с явной меткой"},
        "applies_to": {"$ref": "#/$defs/AppliesTo"},
        "created_from": {"type": "array", "items": {"type": "string"}, "minItems": 1, "description": "Цепочка вывода: факты/ссылки, из которых получено значение (DERIVE/RECONSTRUCT/ARTISTIC_FILL)"},
        "note": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "unknown"}}, "required": ["status"]},
          "then": {"properties": {"value": {"type": "null"}, "medium": {"const": false}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["known", "inferred"]}}, "required": ["status"]},
          "then": {"required": ["source_ref"]}
        },
        {
          "if": {"properties": {"status": {"const": "inferred"}}, "required": ["status"]},
          "then": {"required": ["created_from"]}
        },
        {
          "if": {"properties": {"status": {"enum": ["artistic_model", "fiction"]}}, "required": ["status"]},
          "then": {"properties": {"medium": {"const": true}}, "required": ["applies_to"]}
        }
      ]
    },
    "RelationType": {
      "type": "string",
      "enum": ["located_in", "existed_in", "associated_with", "built_with", "inhabited_by", "wears", "uses", "part_of", "student_of", "mentor_of", "climate_of", "has_architecture"]
    },
    "Relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target", "target_type"],
      "properties": {
        "type": {"$ref": "#/$defs/RelationType"},
        "target": {"type": "string", "minLength": 1, "description": "canonical_id целевой сущности (единый латинский ID-реестр, см. B3A)"},
        "target_type": {"$ref": "#/$defs/EntityType"},
        "label": {"type": "string"},
        "provenance_class": {"$ref": "#/$defs/ProvenanceClass", "default": "author_canon"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "note": {"type": "string"}
      }
    }
  }
}

