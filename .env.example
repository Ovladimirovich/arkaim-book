# ──────────────────────────────────────────────────────────
#  Конфигурация окружения — «Наследие Аркаима»
#  Скопируйте: cp .env.example .env
#  Все переменные используются core/config.py и runtime/
# ──────────────────────────────────────────────────────────

# ── Сеть и порты ──────────────────────────────────────────
# Хост/порт шлюза (gateway) и ядра (core)
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
CORE_HOST=127.0.0.1
CORE_PORT=8642

# URL шлюза для внутреннего API
HERMES_URL=http://127.0.0.1:8080
HERMES_API_KEY=your-api-key-here

# ── Аутентификация и сессии ───────────────────────────────
# Секретный ключ для подписи JWT (обязательно смените!)
SESSION_SECRET=change-me-in-production

# Пути к базам данных аутентификации
AUTH_DB_PATH=runtime/memory/data/auth.db

# API-ключи для программного доступа (через запятую)
API_KEYS=

# ── LLM-провайдеры ───────────────────────────────────────
# Цепочка провайдеров: gigachat,openrouter,huggingface
PROVIDER_CHAIN=gigachat,openrouter,huggingface

# GigaChat
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_TOKEN=
GIGACHAT_VERIFY_SSL=true

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct

# HuggingFace
HF_API_TOKEN=
HF_MODEL=microsoft/Phi-3.5-mini-instruct

# Эмбеддинги
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# ── Настройки API ────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=9090
DEFAULT_LLM_MODEL=GigaChat-Pro

# Разрешённые origins для CORS (через запятую)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── ComfyUI (локальный или Colab через Cloudflare Tunnel) ─
COMFYUI_URL=http://127.0.0.1:8188

# ── Telegram ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_ADMIN_CHAT_ID=

# ── VK (сообщество) ──────────────────────────────────────
VK_GROUP_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199

# ── Email / SMTP ────────────────────────────────────────
# Режимы: mock, smtp, sendgrid
EMAIL_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=true
SENDGRID_API_KEY=
EMAIL_FROM=noreply@arkaim.local
EMAIL_FROM_NAME=Arkaim
EMAIL_DIGEST_INTERVAL=604800

# ── Краудфандинг ─────────────────────────────────────────
CROWDFUNDING_ENABLED=true
CROWDFUNDING_URLS=[]
CROWDFUNDING_CHECK_INTERVAL=3600
CROWDFUNDING_WEBHOOK_URL=
CROWDFUNDING_USER_AGENT=

# ── X-Ray наблюдаемость ──────────────────────────────────
XRAY_TRACE_STORE_PATH=